# Copy to .env and fill in as needed. All vars are optional - see
# app/config.py for defaults.

# Ollama - override the default model if you've pulled a different one
# (e.g. a smaller/faster or larger/better qwen3.5 variant).
SME_OLLAMA_MODEL=qwen3.5:9b

# Gmail integration (email management feature) - create an OAuth client at
# console.cloud.google.com (type "Web application"). Leave blank to disable.
SME_GOOGLE_CLIENT_ID=
SME_GOOGLE_CLIENT_SECRET=
